<Window
    x:Class="WindowsTaskbarMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsTaskbarMonitor.App.Controls"
    Title="Taskbar Monitor">

    <Border
        x:Name="RootSurface"
        Padding="20"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Taskbar Monitor" />
                    <TextBlock
                        x:Name="UpdatedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Waiting for the first sample" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="9,5"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="12">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="LOCAL" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,54">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CPU" />
                                <TextBlock
                                    x:Name="CpuTemperatureText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Unavailable" />
                            </Grid>
                            <TextBlock
                                x:Name="CpuUsageText"
                                Grid.Row="1"
                                Margin="0,8,0,4"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Text="—" />
                            <controls:Sparkline x:Name="CpuSparkline" Grid.Row="2" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,54">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="GPU" />
                                <TextBlock
                                    x:Name="GpuTemperatureText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Unavailable" />
                            </Grid>
                            <TextBlock
                                x:Name="GpuUsageText"
                                Grid.Row="1"
                                Margin="0,8,0,4"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Text="—" />
                            <controls:Sparkline x:Name="GpuSparkline" Grid.Row="2" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,54">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Memory" />
                            <Grid Grid.Row="1" Margin="0,8,0,4" ColumnDefinitions="Auto,*">
                                <TextBlock
                                    x:Name="MemoryUsageText"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Text="—" />
                                <TextBlock
                                    x:Name="MemoryDetailText"
                                    Grid.Column="1"
                                    Margin="12,0,0,4"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="—" />
                            </Grid>
                            <controls:Sparkline x:Name="MemorySparkline" Grid.Row="2" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,54">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Disk throughput" />
                            <Grid Grid.Row="1" Margin="0,10,0,4" ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="READ" />
                                    <TextBlock x:Name="DiskReadText" FontSize="20" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="WRITE" />
                                    <TextBlock x:Name="DiskWriteText" FontSize="20" Text="—" />
                                </StackPanel>
                            </Grid>
                            <controls:Sparkline x:Name="DiskSparkline" Grid.Row="2" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,54">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Network throughput" />
                            <Grid Grid.Row="1" Margin="0,10,0,4" ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="DOWN" />
                                    <TextBlock x:Name="NetworkDownText" FontSize="20" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="UP" />
                                    <TextBlock x:Name="NetworkUpText" FontSize="20" Text="—" />
                                </StackPanel>
                            </Grid>
                            <controls:Sparkline x:Name="NetworkSparkline" Grid.Row="2" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="TRAY READOUT" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Temperatures depend on exposed hardware sensors." />
                </StackPanel>
                <ComboBox
                    x:Name="TrayMetricSelector"
                    Grid.Column="1"
                    MinWidth="106"
                    SelectionChanged="OnTrayMetricSelectionChanged">
                    <ComboBoxItem Content="CPU" />
                    <ComboBoxItem Content="GPU" />
                    <ComboBoxItem Content="Memory" />
                </ComboBox>
            </Grid>
        </Grid>
    </Border>
</Window>
